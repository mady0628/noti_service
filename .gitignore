# =======================================================
# Git Ignore Configuration for Multi-Channel Microservices
# =======================================================

# 1. Dependency Directories
node_modules/
*/node_modules/
*/*/node_modules/

# 2. Environment Variables & Secrets (CRITICAL SECURITY)
.env
*.env
.env.*
!.env.example
service/*/.env
frontend/*/.env

# 3. Local File Storage & User Uploads
service/chat_service/storage/attachments/*
!service/chat_service/storage/attachments/.gitkeep

# 4. Production Build & Distribution
dist/
dist-ssr/
build/
*/dist/
*/build/
.vite/
frontend/*/.vite/

# 5. Logs & Debug Artifacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. Operating System Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 7. IDE, Editor & Tooling Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 8. Temporary & Test Files
coverage/
.nyc_output/
*.tmp
*.temp
scratch/

